{
  "name": "sandbox-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend sandbox para practicar el flujo Git/GitHub y CI/CD (replica de CORSA Backend, sin base de datos)",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "start:dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-data.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "ci": "npm run typecheck && npm run validate:data && npm test"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
